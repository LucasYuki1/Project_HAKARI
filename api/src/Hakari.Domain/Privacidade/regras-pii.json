{
  "_sobre": "Regras do motor de PII do Hakari. Cada regra é um padrão (regex) ou uma lista de termos, com validador e palavras de contexto opcionais. Para criar uma regra nova, acrescente um item aqui e um caso em tests/Hakari.Tests/Privacidade/corpus-pii.json.",
  "versao": 1,
  "regras": [
    {
      "id": "cpf",
      "rotulo": "CPF",
      "categoria": "Identificacao",
      "sensivel": false,
      "padrao": "(?<!\\d)(\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2})(?!\\d)",
      "grupo": 1,
      "validador": "cpf",
      "contexto": [
        "cpf",
        "c.p.f",
        "cadastro de pessoa fisica",
        "documento"
      ],
      "mascara": "[CPF oculto]"
    },
    {
      "id": "cns",
      "rotulo": "cartão do SUS",
      "categoria": "Saude",
      "sensivel": true,
      "padrao": "(?<!\\d)([12789]\\d{2}\\s?\\d{4}\\s?\\d{4}\\s?\\d{4})(?!\\d)",
      "grupo": 1,
      "validador": "cns",
      "contexto": [
        "cns",
        "cartao sus",
        "cartao do sus",
        "cartao nacional de saude",
        "sus"
      ],
      "mascara": "[cartão do SUS oculto]"
    },
    {
      "id": "cartao",
      "rotulo": "cartão de pagamento",
      "categoria": "Financeiro",
      "sensivel": false,
      "padrao": "(?<!\\d)((?:\\d[ -]?){12,18}\\d)(?!\\d)",
      "grupo": 1,
      "validador": "luhn",
      "contexto": [
        "cartao",
        "credito",
        "debito",
        "visa",
        "mastercard",
        "master",
        "elo",
        "amex",
        "hipercard"
      ],
      "mascara": "[cartão oculto]"
    },
    {
      "id": "telefone",
      "rotulo": "telefone",
      "categoria": "Contato",
      "sensivel": false,
      "padrao": "(?<!\\d)((?:\\+?55[\\s.-]?)?\\(?[1-9]{2}\\)?[\\s.-]?(?:9[\\s.-]?\\d{4}|[2-5]\\d{3})[\\s.-]?\\d{4})(?!\\d)",
      "grupo": 1,
      "validador": "telefone",
      "contexto": [
        "tel",
        "telefone",
        "celular",
        "cel",
        "whats",
        "whatsapp",
        "zap",
        "ligar",
        "liguem",
        "ligue",
        "contato",
        "fone",
        "numero"
      ],
      "mascara": "[telefone oculto]"
    },
    {
      "id": "email",
      "rotulo": "e-mail",
      "categoria": "Contato",
      "sensivel": false,
      "padrao": "(?<![\\w.+-])([A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,})(?![\\w-])",
      "grupo": 1,
      "mascara": "[e-mail oculto]"
    },
    {
      "id": "rg",
      "rotulo": "RG",
      "categoria": "Identificacao",
      "sensivel": false,
      "padrao": "(?<!\\d)(\\d{1,2}\\.?\\d{3}\\.?\\d{3}-?[\\dXx])(?![\\dA-Za-z])",
      "grupo": 1,
      "exigeContexto": true,
      "janelaContexto": 25,
      "contexto": [
        "rg",
        "r.g",
        "identidade",
        "registro geral"
      ],
      "mascara": "[RG oculto]"
    },
    {
      "id": "data-nascimento",
      "rotulo": "data de nascimento",
      "categoria": "Identificacao",
      "sensivel": false,
      "padrao": "(?<!\\d)(\\d{1,2}/\\d{1,2}/(?:19|20)\\d{2})(?!\\d)",
      "grupo": 1,
      "exigeContexto": true,
      "janelaContexto": 25,
      "contexto": [
        "nasci",
        "nascido",
        "nascida",
        "nascimento",
        "aniversario",
        "data de nasc"
      ],
      "mascara": "[data de nascimento oculta]"
    },
    {
      "id": "nome-declarado",
      "rotulo": "nome",
      "categoria": "Identificacao",
      "sensivel": false,
      "ignorarCaixa": true,
      "padrao": "\\b(?:meu nome (?:é|e)|me chamo|eu sou (?:o|a))\\s+((?-i:\\p{Lu}\\p{Ll}+)(?:\\s+(?:(?:da|de|do|dos|das|e)\\s+)?(?-i:\\p{Lu}\\p{Ll}+)){0,4})",
      "grupo": 1,
      "mascara": "[nome oculto]"
    },
    {
      "id": "endereco-residencial",
      "rotulo": "endereço residencial",
      "categoria": "Localizacao",
      "sensivel": false,
      "ignorarCaixa": true,
      "padrao": "\\b(?:moro|resido|minha casa (?:fica|é|e)|meu endere[cç]o (?:é|e|fica)|sou morador[a]?)\\s+(?:(?:na|no|em|à|a)\\s+)?((?:rua|r\\.|avenida|av\\.|travessa|tv\\.|alameda|al\\.|estrada|rodovia|pra[cç]a|largo|viela)\\s+[^,.;\\n]{2,60}(?:,?\\s*(?:n[ºo°.]?\\s*)?\\d{1,5}\\b)?)",
      "grupo": 1,
      "mascara": "[endereço residencial oculto]"
    },
    {
      "id": "placa",
      "rotulo": "placa de veículo",
      "categoria": "Identificacao",
      "sensivel": false,
      "ignorarCaixa": true,
      "padrao": "(?<![A-Za-z0-9])([A-Z]{3}-?\\d[A-Z0-9]\\d{2})(?![A-Za-z0-9])",
      "grupo": 1,
      "exigeContexto": true,
      "janelaContexto": 30,
      "contexto": [
        "placa",
        "carro",
        "moto",
        "veiculo",
        "caminhao",
        "onibus",
        "van"
      ],
      "mascara": "[placa oculta]"
    },
    {
      "id": "senha-texto",
      "rotulo": "senha",
      "categoria": "Credencial",
      "sensivel": false,
      "ignorarCaixa": true,
      "padrao": "\\b(?:senha|password|passwd|pwd|pin)\\s*(?:d[oae]s?\\s+[\\wÀ-ÿ-]+\\s+){0,2}(?:é|e|eh|:|=)\\s*[\\\"']?((?=[^\\s\\\"']*(?:[\\d_]|[^\\w\\s\\\"']))[^\\s\\\"']{4,})",
      "grupo": 1,
      "mascara": "[senha oculta]"
    },
    {
      "id": "token-jwt",
      "rotulo": "token de acesso",
      "categoria": "Credencial",
      "sensivel": false,
      "padrao": "\\b(eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,})",
      "grupo": 1,
      "mascara": "[token oculto]"
    },
    {
      "id": "hash-senha",
      "rotulo": "hash de senha",
      "categoria": "Credencial",
      "sensivel": false,
      "padrao": "(\\$2[aby]?\\$\\d{2}\\$[./A-Za-z0-9]{53})",
      "grupo": 1,
      "mascara": "[hash de senha oculto]"
    },
    {
      "id": "chave-acesso",
      "rotulo": "chave de acesso",
      "categoria": "Credencial",
      "sensivel": false,
      "padrao": "\\b(sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|AIza[0-9A-Za-z_-]{35}|xox[abprs]-[A-Za-z0-9-]{10,})",
